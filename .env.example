# Public Supabase URL - safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://yrzawkqcifuubtltktbk.supabase.co
NEXT_PUBLIC_SITE_URL=https://www.thewatchalley.com

# Publishable (anon) key. Safe in the browser; gated by RLS on every read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. NEVER expose to the browser; used only inside Server Actions
# that legitimately need to bypass RLS (admin writes, audit logs, storage proxy).
# The `import "server-only"` directive in src/lib/supabase/admin.ts makes
# leakage a hard build-time error.
SUPABASE_SERVICE_ROLE_KEY=

# Optional salt for hashing subscriber/request IP metadata. If unset, the
# server falls back to existing private runtime secrets; raw IPs are never stored.
WATCH_LIST_IP_HASH_SALT=
WATCH_LIST_UNSUBSCRIBE_SECRET=
WATCH_LIST_DELIVERY_HASH_SECRET=

# Newsletter operations. Vercel Cron uses CRON_SECRET automatically; the app
# also accepts NEWSLETTER_CRON_SECRET for manual calls and local testing.
CRON_SECRET=
NEWSLETTER_CRON_SECRET=
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_TEST_RECIPIENT=
GEMINI_API_KEY=
# Opt in to Gemini Google Search grounding for draft context.
NEWSLETTER_ENABLE_WEB_RESEARCH=false

# Send budgeting. Resend's free tier allows 100 emails a day and the active
# list is 500+, so one issue is several days of sending. The newsletter cron
# runs once a day, which makes a per-run cap a per-day cap; whatever is left
# stays pending and the next run resumes from the delivery log.
# Defaults: 90 broadcast, 20 nudge. Raise both when moving to a paid tier.
NEWSLETTER_MAX_EMAILS_PER_RUN=
NEWSLETTER_NUDGE_MAX_PER_RUN=

# Age window, in hours, for subscribers the profile-completion nudge chases.
# The window was hardcoded to 24-48h, so anyone who signed up before the cron
# existed could never be asked for their preferences: 495 of 550 in Sept 2026.
# Defaults stay at 24-48 so deploying the fix mails nobody new. Raise MAX to
# 43800 (five years) once the re-permission email has gone out, and the nudge
# works through the backlog at NEWSLETTER_NUDGE_MAX_PER_RUN a day. The
# `profile_nudge_sent_at` guard prevents anyone being nudged twice.
NEWSLETTER_NUDGE_MIN_AGE_HOURS=
NEWSLETTER_NUDGE_MAX_AGE_HOURS=

# Admin panel URL token - read by src/proxy.ts. When /admin is visited with
# ?token=<value>, a long-lived cookie is set for return visits. The proxy does
# NOT block access (Supabase Auth + the admin_emails allowlist are the real
# boundary); this only keeps the bookmarkable URL out of casual discovery.
ADMIN_ACCESS_TOKEN=

# Server-only secret for /api/revalidate (on-demand ISR flush from scripts).
# The admin panel authenticates with its Supabase session instead, so this is
# only needed for server-to-server callers. An earlier value was hardcoded in
# public/scripts/admin.js and is burned - never reuse it; set a fresh value.
REVALIDATION_TOKEN=

# Server-only Vercel token used by /api/admin/vercel-analytics to read Web
# Analytics usage for thewatchalley.com. Never expose this to the browser.
VERCEL_API_TOKEN=
# Optional overrides for transferred/forked Vercel projects. Production should
# normally use the Hype Kidz watch-alley values baked into the route.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optional - only needed if you run scripts/transcribe-feedback.mjs locally.
# OPENAI_API_KEY is also reserved for future newsletter hero image generation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
